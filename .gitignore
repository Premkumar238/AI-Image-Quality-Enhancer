# -----------------------------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.cache/
tmp/
temp/
.tmp/
.temp/
*.log

# -----------------------------------------------------------------------------
# Visual Studio Code
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/tasks.json.example
!.vscode/launch.json.example
.history/


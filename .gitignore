# =============================================================================
# AI Image Quality Enhancer — .gitignore
# Covers: Python, PyTorch, Node.js, React, Vite, editors, OS, env, artifacts
# Source code (*.py, *.js, *.jsx, *.ts, *.tsx, etc.) is intentionally tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
pytype/
.pyre/
*.sage.py

# -----------------------------------------------------------------------------
# Python virtual environments
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env/
.virtualenv/
virtualenv/
.python-version

